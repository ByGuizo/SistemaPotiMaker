# Modelo de configuração do PotiMaker.
# Copie este arquivo para ".env" e ajuste os valores. O .env NÃO vai para o git.
#
# Em desenvolvimento, basta a linha abaixo.
DJANGO_DEBUG=True

# ---------------------------------------------------------------------------
# Produção: remova ou mude DJANGO_DEBUG para False e preencha as linhas abaixo.
# ---------------------------------------------------------------------------

# Chave secreta longa e aleatória. Para gerar uma:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=

# Domínios aceitos pelo sistema, separados por vírgula
# DJANGO_ALLOWED_HOSTS=potimaker.exemplo.ifrn.edu.br

# Mesmos domínios, com https://, para os formulários funcionarem atrás do nginx
# DJANGO_CSRF_TRUSTED_ORIGINS=https://potimaker.exemplo.ifrn.edu.br

# Redirecionar http:// para https:// (padrão True em produção)
# DJANGO_SECURE_SSL_REDIRECT=True

# HSTS em segundos (padrão 0 = desligado). Leia o comentário em settings.py antes de ativar.
# DJANGO_SECURE_HSTS_SECONDS=0
